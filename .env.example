# Copie para .env e ajuste. NUNCA versione o arquivo .env.
DB_NAME=gmelcons
DB_USER=gmelcons
DB_PASSWORD=troque-esta-senha

# true = carrega categorias e produtos FICTÍCIOS + usuários de demonstração
APP_SEED_DEMO=true

# Obrigatórios quando APP_SEED_DEMO=false (senha do primeiro administrador)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# Use true quando a aplicação estiver atrás de HTTPS
SESSION_COOKIE_SECURE=false
