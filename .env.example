# Copie para .env e ajuste. NUNCA versione o arquivo .env (já está no .gitignore).
# Este arquivo é só um modelo: os valores abaixo NÃO são segredos reais.

# --- Banco de dados (PostgreSQL) ---
DB_NAME=gmelcons
DB_USER=gmelcons
# OBRIGATÓRIA. Escolha uma senha forte; o docker compose não sobe sem ela.
DB_PASSWORD=troque-esta-senha

# --- Dados de demonstração ---
# true = carrega categorias e produtos FICTÍCIOS + usuários de demonstração
# false = só cria o primeiro administrador (exige APP_ADMIN_PASSWORD)
APP_SEED_DEMO=true

# --- Primeiro administrador ---
APP_ADMIN_USERNAME=admin
# Obrigatória com APP_SEED_DEMO=false. Vazia + demo = senha aleatória exibida uma vez no log
# (docker compose logs app | findstr "senha GERADA"   |   no Linux: ... | grep "senha GERADA")
APP_ADMIN_PASSWORD=
# Senha do usuário "operador" de demonstração (vazia = gerada e exibida uma vez no log)
APP_DEMO_OPERATOR_PASSWORD=

# --- Segurança ---
# Use true quando a aplicação estiver atrás de HTTPS
SESSION_COOKIE_SECURE=false
# Bloqueio temporário de conta contra tentativa de adivinhar senha
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
